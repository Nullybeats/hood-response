.DS_Store

# secrets — NEVER commit (real keys live here)
.env
.env.local
.env.bak*
.env.*.bak*
*.predeploy.*

# local source backups (junk from the pre-git scp workflow)
*.bak
.bak-*/
.fee-backup/

# runtime state — per-tenant positions, journals, sqlite, overrides.
# Anchored to the repo ROOT: a bare `data/` also matches `src/data/`, which holds the tracked
# seed + generated holders. `railway up` honours .gitignore, so the bare pattern silently stripped
# src/data from the feed's build context and broke it with "Cannot find module '../data/seed.js'".
/data/
sniper-store*.json
sniper-owners.json
*.jsonl
*.log
prisma/*.db
prisma/migrations/dev/

# stray artifact from a bad scp of a full local path
Users/
